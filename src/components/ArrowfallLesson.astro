---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, relative } from 'node:path';
import { Code } from 'astro-expressive-code/components';
import { arrowfallById, arrowfallLessons, arrowfallPath } from '../data/arrowfall.mjs';
import { narrativeFor } from '../data/arrowfall-narrative.mjs';

interface Props {
	id: string;
	locale: 'en' | 'pt-br';
}

const { id, locale } = Astro.props;
const lesson = arrowfallById.get(id);
if (!lesson) throw new Error(`Unknown Arrowfall lesson: ${id}`);

const root = join(process.cwd(), 'curriculum', 'arrowfall');
const manifest = JSON.parse(readFileSync(join(root, 'manifest.json'), 'utf8'));
const deliverable = manifest.deliverables.find((item: { id: string }) => item.id === id);
if (!deliverable) throw new Error(`Missing Arrowfall manifest entry: ${id}`);

const checkpoint = join(root, 'checkpoints', id);
const read = (path: string) => readFileSync(join(checkpoint, path), 'utf8');
const input = read('tests/input.txt');
const output = read('tests/output.txt');
const frame = read('tests/frame.txt');
const diff = readFileSync(join(root, 'diffs', `${id}.patch`), 'utf8');
const filesUnder = (directory: string) => existsSync(join(checkpoint, directory))
	? readdirSync(join(checkpoint, directory), { recursive: true, withFileTypes: true })
		.filter((entry) => entry.isFile())
		.map((entry) => relative(checkpoint, join(entry.parentPath, entry.name)))
		.sort()
	: [];
const sourceFiles = ['longbow.toml', 'longbow.lock', ...filesUnder('src'), ...filesUnder('scripts')];
const snippets = lesson.snippets.map((snippet) => {
	const code = read(snippet.file).split('\n').slice(snippet.start - 1, snippet.end).join('\n');
	return { ...snippet, code };
});
const index = arrowfallLessons.findIndex((item) => item.id === id);
const next = index < arrowfallLessons.length - 1 ? arrowfallLessons[index + 1] : undefined;
const local = <T,>(english: T, portuguese: T) => locale === 'pt-br' ? portuguese : english;
const field = (name: string) => (lesson as unknown as Record<string, any>)[locale === 'pt-br' ? `${name}Pt` : name];
const title = (item: (typeof arrowfallLessons)[number]) => locale === 'pt-br' ? item.titlePt : item.title;
const publicFrame = (checkpointId: string) => `/arrowfall/frames/${checkpointId}.svg`;
const lang = (path: string) => path.endsWith('.fl') ? 'flecha' : path.endsWith('.toml') ? 'toml' : path.endsWith('.sh') ? 'sh' : 'text';
const commands = deliverable.commands.join('\n');
const narrative = narrativeFor(id, locale);
if (!narrative) throw new Error(`Missing ${locale} Arrowfall narrative: ${id}`);
if (narrative.snippets.length !== snippets.length) {
	throw new Error(`Arrowfall narrative/snippet mismatch: ${id} (${locale})`);
}
---

<article data-arrowfall-lesson={id}>
<p><strong>{local('Current source', 'Fonte atual')}:</strong> <code>curriculum/arrowfall/checkpoints/{id}</code> · Flecha {manifest.toolchain.version} · {index + 1}/7.</p>

<h2 id="already-built">{local('The program at this checkpoint', 'O programa neste checkpoint')}</h2>
<p><strong>{local('Previously', 'Até aqui')}:</strong> {field('built')}</p>
{narrative.context.map((paragraph: string) => <p>{paragraph}</p>)}

<h2 id="observed-limitation">{local('Current limitation', 'Limitação atual')}</h2>
<p>{field('limitation')}</p>
<p><strong>{local('Required next behavior', 'Próximo comportamento necessário')}:</strong> {field('desired')}</p>

<h2 id="design-decision">{local('Model and invariants', 'Modelo e invariantes')}</h2>
<p>{field('decision')}</p>
<p>{field('concept')}</p>
{narrative.model.map((paragraph: string) => <p>{paragraph}</p>)}

<h2 id="implement">{local('Implementation', 'Implementação')}</h2>
<p>{local(
	'The implementation is split into the changes below. Each excerpt is taken verbatim from the qualified checkpoint and is explained in the part of the data flow where it is used. The excerpts are not standalone programs; the complete compiled source is available after the run.',
	'A implementação está dividida nas mudanças abaixo. Cada trecho vem literalmente do checkpoint qualificado e é explicado na parte do fluxo de dados em que participa. Os trechos não são programas independentes; o código completo compilado está disponível depois da execução.',
)}</p>
<ul>
	{field('changes').map((change: string) => <li>{change}</li>)}
</ul>

{snippets.map((snippet, snippetIndex) => (
	<section>
		<h3>{locale === 'pt-br' ? snippet.labelPt : snippet.label}</h3>
		{narrative.snippets[snippetIndex].before.map((paragraph: string) => <p>{paragraph}</p>)}
		<p><strong>{local('Excerpt', 'Trecho')}:</strong> <code>{snippet.file}:{snippet.start}–{snippet.end}</code>. {local(
			'The complete file appears in the source section below.',
			'O arquivo completo aparece na seção de código abaixo.',
		)}</p>
		<Code code={snippet.code} lang="flecha" meta={`title="${snippet.file}:${snippet.start}-${snippet.end} (excerpt)"`} />
		{narrative.snippets[snippetIndex].after.map((paragraph: string) => <p>{paragraph}</p>)}
	</section>
))}

<h2 id="run-and-compare">{local('Run and inspect the result', 'Execute e examine o resultado')}</h2>
<p id="run-the-current-checkpoint">{local(
	'The command uses the checkpoint’s recorded input, so the behavior described above can be reproduced without manual timing.',
	'O comando usa a entrada registrada do checkpoint, portanto o comportamento descrito acima pode ser reproduzido sem depender de tempo manual.',
)}</p>
<Code code={deliverable.commands[3]} lang="sh" meta={`title="${local('Run command', 'Comando de execução')}"`} />

{input.trim() && (
	<details>
		<summary>{local('Recorded standard input', 'Entrada padrão registrada')}</summary>
		<Code code={input} lang="text" meta={`title="${local('Standard input', 'Entrada padrão')}"`} />
	</details>
)}

{narrative.run.slice(0, 1).map((paragraph: string) => <p>{paragraph}</p>)}
<figure>
	<img src={publicFrame(id)} alt={local(`Terminal frame produced by version ${index + 1}: ${lesson.title}`, `Frame de terminal produzido pela versão ${index + 1}: ${lesson.titlePt}`)} />
	<figcaption>{local(
		`Representative frame from the recorded run of checkpoint ${index + 1}.`,
		`Frame representativo da execução registrada do checkpoint ${index + 1}.`,
	)}</figcaption>
</figure>
{narrative.run.slice(1).map((paragraph: string) => <p>{paragraph}</p>)}

<details>
	<summary>{local('Accessible frame transcript', 'Transcript acessível do frame')}</summary>
	<Code code={frame} lang="text" meta={`title="${local('Frame transcript', 'Transcript do frame')}"`} />
</details>

<details>
	<summary>{local('Complete recorded stdout', 'Stdout registrada completa')}</summary>
	<Code code={output} lang="text" meta={`title="${local('Expected stdout', 'Stdout esperada')}"`} />
</details>

<h2 id="checkpoint-result">{local('What this checkpoint establishes', 'O que este checkpoint estabelece')}</h2>
{narrative.conclusion.map((paragraph: string) => <p>{paragraph}</p>)}

<h2 id="challenge">{local('Exercise', 'Exercício')}</h2>
<p>{field('challenge')}</p>

<h2 id="source-and-verification">{local('Complete source and verification', 'Código completo e verificação')}</h2>
<p>{local(
	'The sections below preserve the complete qualified source, the exact predecessor diff, and the command sequence used by CI. They are supporting evidence for the implementation explained above.',
	'As seções abaixo preservam o código qualificado completo, o diff exato desde o predecessor e a sequência de comandos usada pela CI. São evidência de apoio para a implementação explicada acima.',
)}</p>

<details>
	<summary>{local(`Complete tested source (${sourceFiles.length} files)`, `Código completo testado (${sourceFiles.length} arquivos)`)}</summary>
	{sourceFiles.map((path) => (
		<section>
			<h3><code>{path}</code></h3>
			<Code code={read(path)} lang={lang(path)} meta={`title="${path}"`} />
		</section>
	))}
</details>

<details>
	<summary>{local('Exact diff from the preceding version', 'Diff exato desde a versão anterior')}</summary>
	<Code code={diff} lang="diff" />
</details>

<details>
	<summary>{local('Check, test, build, and run commands', 'Comandos de check, teste, build e execução')}</summary>
	<Code code={commands} lang="sh" meta={`title="${local('Verification commands', 'Comandos de verificação')}"`} />
</details>

<h2 id="cumulative-timeline">{local('Versions in this tutorial', 'Versões deste tutorial')}</h2>
<ol>
	{arrowfallLessons.slice(0, index + 1).map((item, itemIndex) => (
		<li>{item.id === id
			? <strong>{itemIndex + 1}. {title(item)}</strong>
			: <a href={arrowfallPath(item.slug, locale)}>{itemIndex + 1}. {title(item)}</a>}</li>
	))}
</ol>

{next ? (
	<>
		<h2 id={locale === 'pt-br' ? 'o-que-aprender-a-seguir' : 'what-to-learn-next'}>{local('Next version', 'Próxima versão')}</h2>
		<p>{field('next')}</p>
		<p><a href={arrowfallPath(next.slug, locale)}>{title(next)}</a></p>
	</>
) : (
	<>
		<h2 id="project-complete">{local('Result and scope', 'Resultado e escopo')}</h2>
		<p>{field('next')}</p>
		<p>{local(
			'The final game does not include an unsafe subsystem. Unsafe code is outside the scope of this tutorial because the game has no measured native boundary that requires it.',
			'O jogo final não inclui subsistema unsafe. Código unsafe está fora do escopo deste tutorial porque o jogo não tem uma fronteira nativa medida que o exija.',
		)}</p>
	</>
)}

<h2 id="references">{local('References', 'Referências')}</h2>
<ul>
	{(locale === 'pt-br' ? lesson.referencesPt : lesson.references).map(([label, href]) => <li><a href={href}>{label}</a></li>)}
</ul>

<p>{local(
	`Source: Arrowfall commit 56bb003, verified with official Flecha ${manifest.toolchain.version}. The source, input, output, diff, and frame on this page are read from that committed snapshot.`,
	`Fonte: commit Arrowfall 56bb003, verificado com Flecha oficial ${manifest.toolchain.version}. Código, entrada, saída, diff e frame desta página são lidos desse snapshot versionado.`,
)}</p>
</article>
