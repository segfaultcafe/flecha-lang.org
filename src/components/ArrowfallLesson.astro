---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, relative } from 'node:path';
import { Code } from 'astro:components';
import { arrowfallById, arrowfallLessons, arrowfallPath } from '../data/arrowfall.mjs';

interface Props {
	id: string;
	locale: 'en' | 'pt-br';
}

const { id, locale } = Astro.props;
const lesson = arrowfallById.get(id);
if (!lesson) throw new Error(`Unknown Arrowfall lesson: ${id}`);

const root = join(process.cwd(), 'curriculum', 'arrowfall');
const manifest = JSON.parse(readFileSync(join(root, 'manifest.json'), 'utf8'));
const deliverable = manifest.deliverables.find((item: { id: string }) => item.id === id);
if (!deliverable) throw new Error(`Missing Arrowfall manifest entry: ${id}`);

const checkpoint = join(root, 'checkpoints', id);
const read = (path: string) => readFileSync(join(checkpoint, path), 'utf8');
const input = read('tests/input.txt');
const output = read('tests/output.txt');
const frame = read('tests/frame.txt');
const diff = readFileSync(join(root, 'diffs', `${id}.patch`), 'utf8');
const filesUnder = (directory: string) => existsSync(join(checkpoint, directory))
	? readdirSync(join(checkpoint, directory), { recursive: true, withFileTypes: true })
		.filter((entry) => entry.isFile())
		.map((entry) => relative(checkpoint, join(entry.parentPath, entry.name)))
		.sort()
	: [];
const sourceFiles = ['longbow.toml', 'longbow.lock', ...filesUnder('src'), ...filesUnder('scripts')];
const snippets = lesson.snippets.map((snippet) => {
	const code = read(snippet.file).split('\n').slice(snippet.start - 1, snippet.end).join('\n');
	return { ...snippet, code };
});
const index = arrowfallLessons.findIndex((item) => item.id === id);
const predecessor = index > 0 ? arrowfallLessons[index - 1] : undefined;
const next = index < arrowfallLessons.length - 1 ? arrowfallLessons[index + 1] : undefined;
const local = <T,>(english: T, portuguese: T) => locale === 'pt-br' ? portuguese : english;
const field = (name: string) => (lesson as unknown as Record<string, any>)[locale === 'pt-br' ? `${name}Pt` : name];
const title = (item: (typeof arrowfallLessons)[number]) => locale === 'pt-br' ? item.titlePt : item.title;
const publicFrame = (checkpointId: string) => `/arrowfall/frames/${checkpointId}.svg`;
const lang = (path: string) => path.endsWith('.toml') ? 'toml' : 'text';
const commands = deliverable.commands.join('\n');
---

<article data-arrowfall-lesson={id}>
<div class="checkpoint-identity">
	<span>{local('ARROWFALL checkpoint', 'Checkpoint ARROWFALL')} {index + 1}/7</span>
	<span>Flecha {manifest.toolchain.version}</span>
	<span>{id}</span>
</div>

<aside class="built-panel" aria-labelledby="already-built">
	<h2 id="already-built">{local('You already built', 'Você já construiu')}</h2>
	<p>{field('built')}</p>
</aside>

<h2 id="run-the-current-checkpoint">{local('1. Run the current checkpoint', '1. Execute o checkpoint atual')}</h2>

<p>{local(
	'Begin with the program as it exists now. From the canonical Arrowfall source tree, run the recorded command and give it the recorded input.',
	'Comece com o programa como ele existe agora. Na árvore de fontes canônica do Arrowfall, execute o comando registrado e forneça a entrada registrada.',
)}</p>

<Code code={deliverable.commands[3]} lang="sh" />

<details>
	<summary>{local('Scripted stdin', 'Entrada stdin roteirizada')}</summary>
	<pre class="terminal transcript"><code>{input || local('(empty)', '(vazia)')}</code></pre>
</details>

<div class="frame-grid">
	<figure>
		<img src={publicFrame(id)} alt={local(`Validated terminal frame for checkpoint ${index + 1}: ${lesson.title}`, `Frame de terminal validado do checkpoint ${index + 1}: ${lesson.titlePt}`)} />
		<figcaption>{local('The actual validated frame for this checkpoint.', 'O frame real validado deste checkpoint.')}</figcaption>
	</figure>
	<div>
		<p class="visual-label">{local('Accessible frame transcript', 'Transcrição acessível do frame')}</p>
		<pre class="terminal frame-text"><code>{frame}</code></pre>
	</div>
</div>

{predecessor && (
	<details class="comparison">
		<summary>{local('Compare with the previous playable result', 'Compare com o resultado jogável anterior')}</summary>
		<div class="frame-grid compact">
			<figure>
				<img src={publicFrame(predecessor.id)} alt={local(`Previous frame: ${predecessor.title}`, `Frame anterior: ${predecessor.titlePt}`)} />
				<figcaption>{title(predecessor)}</figcaption>
			</figure>
			<figure>
				<img src={publicFrame(id)} alt={local(`Current frame: ${lesson.title}`, `Frame atual: ${lesson.titlePt}`)} />
				<figcaption>{title(lesson)}</figcaption>
			</figure>
		</div>
	</details>
)}

<h2 id="observed-limitation">{local('2. Observe the limitation', '2. Observe a limitação')}</h2>
<p>{field('limitation')}</p>

<h2 id="desired-behaviour">{local('3. Decide what the game needs next', '3. Decida o que o jogo precisa agora')}</h2>
<p>{field('desired')}</p>

<h2 id="design-decision">{local('4. Choose the smallest model', '4. Escolha o menor modelo')}</h2>
<p>{field('decision')}</p>

<h2 id="flecha-concept">{local('5. Introduce the Flecha concept—because it is needed now', '5. Introduza o conceito Flecha — porque ele é necessário agora')}</h2>
<p>{field('concept')}</p>

<h2 id="implement">{local('6. Implement the change', '6. Implemente a mudança')}</h2>

<ul>
	{field('changes').map((change: string) => <li>{change}</li>)}
</ul>

{snippets.map((snippet) => (
	<section class="snippet">
		<h3>{locale === 'pt-br' ? snippet.labelPt : snippet.label}</h3>
		<p class="source-location">{snippet.file}:{snippet.start}–{snippet.end}</p>
		<Code code={snippet.code} lang="text" />
	</section>
))}

<details class="source-bundle">
	<summary>{local(`Complete checkpoint source (${sourceFiles.length} files)`, `Código completo do checkpoint (${sourceFiles.length} arquivos)`)}</summary>
	{sourceFiles.map((path) => (
		<section>
			<h3>{path}</h3>
			<Code code={read(path)} lang={lang(path)} />
		</section>
	))}
</details>

<details class="source-diff">
	<summary>{local('Exact cumulative diff from the previous checkpoint', 'Diff cumulativo exato desde o checkpoint anterior')}</summary>
	<Code code={diff} lang="diff" />
</details>

<h2 id="run-and-compare">{local('7. Run it and compare', '7. Execute e compare')}</h2>

<p>{local(
	'These are the exact commands recorded in the frozen manifest. Check, test, and build must all succeed before the transcript is accepted.',
	'Estes são os comandos exatos registrados no manifesto congelado. Check, test e build devem passar antes de a transcrição ser aceita.',
)}</p>

<Code code={commands} lang="sh" />

<details open>
	<summary>{local('Exact expected stdout', 'Stdout esperado exato')}</summary>
	<pre class="terminal transcript"><code>{output}</code></pre>
</details>

<aside class="acceptance">
	<h2 id="challenge">{local('Small challenge and acceptance', 'Pequeno desafio e aceite')}</h2>
	<p>{field('challenge')}</p>
</aside>

<h2 id="cumulative-timeline">{local('Cumulative timeline', 'Linha do tempo cumulativa')}</h2>
<ol class="timeline">
	{arrowfallLessons.slice(0, index + 1).map((item, itemIndex) => (
		<li class={item.id === id ? 'current' : undefined}>
			{item.id === id
				? <strong>{itemIndex + 1}. {title(item)}</strong>
				: <a href={arrowfallPath(item.slug, locale)}>{itemIndex + 1}. {title(item)}</a>}
		</li>
	))}
</ol>

{next ? (
	<>
		<h2 id={locale === 'pt-br' ? 'o-que-aprender-a-seguir' : 'what-to-learn-next'}>{local('What to learn next', 'O que aprender a seguir')}</h2>
		<p>{field('next')}</p>
		<p><a href={arrowfallPath(next.slug, locale)}><strong>{local('Continue to', 'Continue para')} {title(next)} →</strong></a></p>
	</>
) : (
	<>
		<h2 id="project-complete">{local('ARROWFALL is qualified', 'ARROWFALL está qualificado')}</h2>
		<p>{field('next')}</p>
		<p>{local(
			'The final safe game intentionally has no unsafe subsystem. That boundary remains a separate reference topic, not a required tutorial step.',
			'O jogo seguro final intencionalmente não tem subsistema unsafe. Essa fronteira continua como referência separada, não como etapa obrigatória do tutorial.',
		)}</p>
	</>
)}

<h2 id="references">{local('Reference after the checkpoint', 'Referência depois do checkpoint')}</h2>
<ul>
	{(locale === 'pt-br' ? lesson.referencesPt : lesson.references).map(([label, href]) => <li><a href={href}>{label}</a></li>)}
</ul>

<p class="provenance">{local(
	`Source frozen at Arrowfall commit 56bb003; qualified with official Flecha ${manifest.toolchain.version}. Code, input, output, diffs, and frames on this page are rendered from that committed snapshot.`,
	`Fonte congelada no commit Arrowfall 56bb003; qualificada com Flecha oficial ${manifest.toolchain.version}. Código, entrada, saída, diffs e frames desta página são renderizados desse snapshot versionado.`,
)}</p>
</article>

<style>
	.checkpoint-identity { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1rem 1.5rem; }
	.checkpoint-identity span { border: 1px solid var(--sl-color-gray-5); border-radius: 999px; padding: .3rem .7rem; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.built-panel, .acceptance { border-inline-start: .3rem solid var(--sl-color-accent); border-radius: .4rem; padding: .5rem 1rem; background: color-mix(in srgb, var(--sl-color-accent-low) 30%, transparent); }
	.built-panel h2, .acceptance h2 { margin-top: .35rem; }
	.frame-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr)); gap: 1rem; align-items: start; margin-block: 1.25rem; }
	.frame-grid.compact { grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); }
	figure { margin: 0; min-width: 0; }
	figure img { display: block; width: 100%; height: auto; border: 1px solid var(--sl-color-gray-5); border-radius: .55rem; background: #07100d; }
	figcaption, .source-location, .provenance { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.visual-label { font-weight: 700; margin-top: 0; }
	.terminal { max-width: 100%; overflow: auto; border: 1px solid var(--sl-color-gray-5); border-radius: .55rem; padding: 1rem; background: #07100d; color: #d8f3dc; font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); line-height: 1.45; }
	.frame-text { min-height: 10rem; }
	.transcript { max-height: 32rem; }
	details { margin-block: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .55rem; padding: .75rem; }
	summary { cursor: pointer; font-weight: 700; }
	.snippet, .source-bundle section { min-width: 0; }
	.source-bundle h3 { overflow-wrap: anywhere; }
	.timeline { border-inline-start: 2px solid var(--sl-color-gray-5); padding-inline-start: 1.5rem; }
	.timeline li { padding-block: .25rem; }
	.timeline .current { color: var(--sl-color-accent-high); }
	.provenance { border-top: 1px solid var(--sl-color-gray-5); padding-top: 1rem; }
	@media (max-width: 40rem) {
		.frame-grid { grid-template-columns: 1fr; }
		.terminal { font-size: .78rem; }
		details { padding: .6rem; }
	}
</style>
