---
import { curriculumLessons, curriculumPath, findCurriculumLesson } from '../data/curriculum.mjs';
import { arrowfallLessons, arrowfallPath, findArrowfallLesson } from '../data/arrowfall.mjs';

const locale = Astro.url.pathname.startsWith('/pt-br/') ? 'pt-br' : 'en';
const curriculumCurrent = findCurriculumLesson(Astro.url.pathname);
const arrowfallCurrent = findArrowfallLesson(Astro.url.pathname);
const series = arrowfallCurrent ? arrowfallLessons : curriculumLessons;
const current = arrowfallCurrent ?? curriculumCurrent;
const currentIndex = current ? series.findIndex((lesson) => lesson.slug === current.slug) : -1;
const previous = currentIndex > 0 ? series[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < series.length - 1 ? series[currentIndex + 1] : undefined;
const path = (slug: string) => arrowfallCurrent ? arrowfallPath(slug, locale) : curriculumPath(slug, locale);
const title = (lesson: (typeof series)[number]) => locale === 'pt-br' ? lesson.titlePt : lesson.title;
---

{current && (
	<div class="curriculum-pagination print:hidden" data-curriculum-pagination data-series={arrowfallCurrent ? 'arrowfall' : 'main'} data-track={'track' in current ? current.track : undefined}>
		{previous && (
			<a href={path(previous.slug)} rel="prev">
				<span class="direction">{locale === 'pt-br' ? 'Anterior' : 'Previous'}</span>
				<span class="link-title">← {title(previous)}</span>
			</a>
		)}
		{next && (
			<a href={path(next.slug)} rel="next">
				<span class="direction">{locale === 'pt-br' ? 'Próximo' : 'Next'}</span>
				<span class="link-title">{title(next)} →</span>
			</a>
		)}
	</div>
)}

<style>
	@layer starlight.core {
		.curriculum-pagination { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 1rem; }
		a { display: flex; flex-direction: column; justify-content: center; gap: .25rem; width: 100%; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; padding: 1rem; text-decoration: none; color: var(--sl-color-gray-2); box-shadow: var(--sl-shadow-md); overflow-wrap: anywhere; }
		a[rel='next'] { text-align: end; grid-column-end: -1; }
		a:hover { border-color: var(--sl-color-gray-2); }
		.direction { font-size: var(--sl-text-sm); }
		.link-title { color: var(--sl-color-white); font-size: var(--sl-text-xl); line-height: var(--sl-line-height-headings); }
	}
</style>
