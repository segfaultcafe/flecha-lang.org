---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const portuguese = Astro.url.pathname === '/pt-br/' || Astro.url.pathname.startsWith('/pt-br/');
const prefix = portuguese ? '/pt-br' : '';
const nav = portuguese
	? [['Instalar', 'install'], ['Aprender', 'learn'], ['Documentação', 'docs'], ['Exemplos', 'examples'], ['Versões', 'releases']]
	: [['Install', 'install'], ['Learn', 'learn'], ['Docs', 'docs'], ['Examples', 'examples'], ['Releases', 'releases']];
---

<div class="header">
	<div class="title-wrapper sl-flex"><SiteTitle /></div>
	<nav aria-label={portuguese ? 'Navegação principal' : 'Primary navigation'}>
		{nav.map(([label, slug]) => <a href={`${prefix}/${slug}/`}>{label}</a>)}
	</nav>
	<div class="sl-flex search-slot print:hidden">{shouldRenderSearch && <Search />}</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons"><SocialIcons /></div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header { display: flex; gap: 1.1rem; justify-content: space-between; align-items: center; height: 100%; }
		.title-wrapper { overflow: clip; padding: 0.25rem; margin: -0.25rem; min-width: 0; }
		nav { display: none; align-items: center; gap: 1.25rem; margin-inline: auto; }
		nav a { color: var(--sl-color-text); font-size: 0.9rem; font-weight: 650; text-decoration: none; }
		nav a:hover { color: var(--sl-color-accent-high); }
		.right-group, .social-icons { gap: 1rem; align-items: center; }
		.social-icons::after { content: ''; height: 2rem; border-inline-end: 1px solid var(--sl-color-gray-5); }
		.search-slot { min-width: 0; }
		@media (min-width: 80rem) { nav { display: flex; } }
	}
</style>
