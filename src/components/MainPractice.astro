---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Code } from 'astro:components';
import { mainPractice } from '../data/main-practice.mjs';

interface Props {
	id: keyof typeof mainPractice;
	locale: 'en' | 'pt-br';
}
const { id, locale } = Astro.props;
const practice = mainPractice[id];
if (!practice) throw new Error(`Unknown main curriculum practice: ${id}`);
const source = readFileSync(join(process.cwd(), practice.source), 'utf8');
const snippet = source.split('\n').slice(practice.start - 1, practice.end).join('\n');
const goal = locale === 'pt-br' ? practice.goalPt : practice.goal;
const output = practice.expectedStdout || (locale === 'pt-br' ? '(stdout vazio)' : '(empty stdout)');
---

<aside class="practice" data-main-practice={id}>
	<p class="eyebrow">{locale === 'pt-br' ? 'Checkpoint prático validado' : 'Validated practice checkpoint'}</p>
	<h2>{locale === 'pt-br' ? 'Faça o conceito trabalhar' : 'Make the concept do work'}</h2>
	<p>{goal}</p>
	<p class="source">{practice.source}:{practice.start}–{practice.end}</p>
	<Code code={snippet} lang="text" />
	<h3>{locale === 'pt-br' ? 'Verifique com Flecha v0.3.0' : 'Verify with Flecha v0.3.0'}</h3>
	<Code code={practice.commands.join('\n')} lang="sh" />
	<h3>{locale === 'pt-br' ? 'Resultado registrado' : 'Recorded result'}</h3>
	<pre><code>{`${output}\n${locale === 'pt-br' ? 'status de saída' : 'exit status'}: ${practice.expectedStatus}`}</code></pre>
	<p><a href={locale === 'pt-br' ? `/pt-br${practice.href}` : practice.href}>{locale === 'pt-br' ? 'Abra o exemplo ou contrato completo' : 'Open the complete example or contract'} →</a></p>
</aside>

<style>
	.practice { margin-block: 2rem; border: 1px solid var(--sl-color-gray-5); border-inline-start: .3rem solid var(--sl-color-accent); border-radius: .6rem; padding: 1rem; background: color-mix(in srgb, var(--sl-color-bg-nav) 90%, transparent); }
	.practice h2 { margin-top: .25rem; }
	.eyebrow { margin: 0; color: var(--sl-color-accent-high); font-size: var(--sl-text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.source { color: var(--sl-color-gray-2); font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); overflow-wrap: anywhere; }
	pre { max-width: 100%; overflow: auto; border: 1px solid var(--sl-color-gray-5); border-radius: .45rem; padding: .8rem; background: #07100d; color: #d8f3dc; }
</style>
