---
import { arrowfallLessons, arrowfallPath } from '../data/arrowfall.mjs';

const locale = Astro.url.pathname.startsWith('/pt-br/') ? 'pt-br' : 'en';
const title = (lesson: (typeof arrowfallLessons)[number]) => locale === 'pt-br' ? lesson.titlePt : lesson.title;
---

<section>
	<p>{locale === 'pt-br'
		? 'O tutorial ARROWFALL contém sete versões cumulativas de um jogo de terminal. Cada versão é compilada e executada com Flecha v0.3.0; entradas e saídas são verificadas contra fixtures versionadas.'
		: 'The ARROWFALL tutorial contains seven cumulative versions of a terminal game. Each version is compiled and run with Flecha v0.3.0; input and output are checked against committed fixtures.'}</p>
	<ol>
		{arrowfallLessons.map((lesson, index) => (
			<li><a href={arrowfallPath(lesson.slug, locale)}>{index + 1}. {title(lesson)}</a></li>
		))}
	</ol>
</section>
