---
import { arrowfallLessons, arrowfallPath } from '../data/arrowfall.mjs';

const locale = Astro.url.pathname.startsWith('/pt-br/') ? 'pt-br' : 'en';
const title = (lesson: (typeof arrowfallLessons)[number]) => locale === 'pt-br' ? lesson.titlePt : lesson.title;
---

<article class="arrowfall-card">
	<div>
		<p class="eyebrow">{locale === 'pt-br' ? 'Tutorial de projeto independente' : 'Independent project tutorial'}</p>
		<h2>{locale === 'pt-br' ? 'Construa ARROWFALL' : 'Build ARROWFALL'}</h2>
		<p>{locale === 'pt-br'
			? 'Evolua uma masmorra ASCII real: estado, WASD, colisão, goblin, HP, arco, seed reproduzível e testes.'
			: 'Grow a real ASCII dungeon through state, WASD, collision, a goblin, HP, archery, a reproducible seed, and tests.'}</p>
		<p>{locale === 'pt-br'
			? 'Sete projetos cumulativos completos, executados com Flecha v0.3.0 e comparados com saídas golden.'
			: 'Seven complete cumulative projects, executed with Flecha v0.3.0 and compared with golden output.'}</p>
		<a class="start" href={arrowfallPath(arrowfallLessons[0].slug, locale)}>
			{locale === 'pt-br' ? 'Começar ARROWFALL' : 'Start ARROWFALL'} →
		</a>
	</div>
	<ol>
		{arrowfallLessons.map((lesson, index) => (
			<li><a href={arrowfallPath(lesson.slug, locale)}><span>{index + 1}</span>{title(lesson)}</a></li>
		))}
	</ol>
</article>

<style>
	.arrowfall-card { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(16rem, .95fr); gap: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-top: .3rem solid var(--sl-color-accent); border-radius: .75rem; padding: 1.25rem; background: color-mix(in srgb, var(--sl-color-bg-nav) 88%, transparent); box-shadow: var(--sl-shadow-md); }
	.arrowfall-card h2 { margin-top: .25rem; }
	.eyebrow { color: var(--sl-color-accent-high); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: var(--sl-text-xs); }
	.start { display: inline-block; font-weight: 700; text-decoration: none; }
	ol { margin: 0; padding: 0; list-style: none; display: grid; gap: .45rem; }
	li a { display: grid; grid-template-columns: 2rem 1fr; gap: .65rem; align-items: center; text-decoration: none; }
	li span { display: grid; place-items: center; inline-size: 1.8rem; block-size: 1.8rem; border-radius: 50%; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-weight: 700; }
	@media (max-width: 48rem) { .arrowfall-card { grid-template-columns: 1fr; } }
</style>
