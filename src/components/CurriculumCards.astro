---
import { curriculumPath, curriculumTracks } from '../data/curriculum.mjs';

const locale = Astro.url.pathname.startsWith('/pt-br/') ? 'pt-br' : 'en';
---

<div>
	{curriculumTracks.map((track, index) => (
		<section>
			<h2>{locale === 'pt-br' ? track.titlePt : track.title}</h2>
			<p>{locale === 'pt-br' ? track.outcomePt : track.outcome}</p>
			<p><strong>{locale === 'pt-br' ? 'Pré-requisito' : 'Prerequisite'}:</strong> {locale === 'pt-br' ? track.prerequisitePt : track.prerequisite}</p>
			<p><strong>{locale === 'pt-br' ? 'Escopo' : 'Scope'}:</strong> {locale === 'pt-br' ? track.scopePt : track.scope}</p>
			<p><a href={curriculumPath(track.lessons[0].slug, locale)}>{index + 1}. {locale === 'pt-br' ? track.titlePt : track.title}</a></p>
		</section>
	))}
</div>
