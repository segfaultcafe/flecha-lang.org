module main;

@imports :: root::game :: root::input :: root::render;

void main() {
    state := game::Game::start();
    while state.outcome() == game::Outcome.Playing {
        frame, frameError := render::draw(&state);
        if frameError != none {
            stdoutln("Could not render the room.");
            return;
        }
        stdoutln(frame);
        command, commandError := input::read_command();
        stdoutln();
        if commandError != none {
            stdoutln("Unknown command. No turn spent.");
            proceed;
        }
        event := state.apply(command);
        stdoutln(render::event_message(event));
    }
    finalFrame, finalError := render::draw(&state);
    if finalError == none {
        stdoutln(finalFrame);
    }
    if state.outcome() == game::Outcome.Won {
        stdoutln("You escaped Arrowfall!");
    }
}
