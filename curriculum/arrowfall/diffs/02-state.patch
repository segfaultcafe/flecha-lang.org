diff -rN -U0 --exclude target tutorial/checkpoints/01-scene/src/main.fl tutorial/checkpoints/02-state/src/main.fl
--- tutorial/checkpoints/01-scene/src/main.fl
+++ tutorial/checkpoints/02-state/src/main.fl
@@ -2,0 +3,26 @@
+structure Position {
+    i32 x;
+    i32 y;
+};
+
+structure Game {
+    private Position player;
+};
+
+Position Position::at(i32 x, i32 y) {
+    return build Position {
+        self.x = x;
+        self.y = y;
+    };
+}
+
+Game Game::start() {
+    return build Game {
+        self.player = Position::at(1, 1);
+    };
+}
+
+Position Game::playerPosition(&const self) {
+    return self->player;
+}
+
@@ -3,0 +30,2 @@
+    state := Game::start();
+    player := state.playerPosition();
@@ -6 +34 @@
-    stdoutln("#@.>#");
+    draw_row(player);
@@ -7,0 +36,15 @@
+    stdoutln("Player: (", player.x, ", ", player.y, ")");
+}
+
+void draw_row(Position player) {
+    stdout("#");
+    loop i32 x = 1; x < 4; x++ {
+        if player.x == x and player.y == 1 {
+            stdout("@");
+        } else if x == 3 {
+            stdout(">");
+        } else {
+            stdout(".");
+        }
+    }
+    stdoutln("#");
