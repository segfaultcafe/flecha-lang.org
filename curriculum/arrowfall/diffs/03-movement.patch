+void Game::apply(&self, Command command) {
+    if command == Command.Up and self->player.y > 0 {
+        self->player.y--;
+    } else if command == Command.Left and self->player.x > 0 {
+        self->player.x--;
+    } else if command == Command.Down and self->player.y < 2 {
+        self->player.y++;
+    } else if command == Command.Right and self->player.x < 4 {
